{
  "name": "kairis",
  "version": "0.1.0",
  "private": true,
  "description": "Kairis app scaffold for disciplined non-custodial crypto trading workflows.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@coinbase/cdp-sdk": "^1.58.0",
    "@qavren/auth-next": "^0.1.2",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "axios": ">=1.18.0",
    "postcss": "^8.5.18",
    "ws": ">=8.21.0",
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@2": "^2.1.3",
    "brace-expansion@5": "^5.0.8",
    "sharp@0": "^0.35.5",
    "source-map-js": "^1.2.2",
    "undici": "^7.29.0"
  }
}
