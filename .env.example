# Copy to .env.local for local development. Never commit .env files with real values.
# Production values are listed in docs/deployment.md.

NEXT_PUBLIC_APP_NAME=Kairis
NEXT_PUBLIC_APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Auth.js. Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
# qavren-auth Keycloak. Local development uses the kairis-dev realm; production uses kairis.
QAVREN_AUTH_URL=https://auth.qavrensolutions.com
QAVREN_REALM=kairis-dev

# Comma-separated emails that count as owners (operations page, auto cycle). A realm role "owner" also works.
KAIRIS_OWNER_EMAILS=
# Seals stored Coinbase keys (AES-256-GCM); 32 random bytes, base64, same generator as AUTH_SECRET.
# Exchange connections are disabled while this is empty. Changing it forces users to reconnect.
KAIRIS_SECRET_KEY=

# Required. Local: the compose.dev.yaml Postgres (npm run db:up).
# Production: the qavren-db transaction pooler (port 6543), role kairis.<project-ref>.
DATABASE_URL=postgres://kairis:kairis@localhost:55433/kairis

# Both stay false until deliberately enabled. Live submission also needs a connected Coinbase key.
ENABLE_LIVE_ASSISTED_TRADING=false
# Owner-only auto cycle; also requires ENABLE_LIVE_ASSISTED_TRADING=true.
ENABLE_AUTO_MODE=false

# Cloudflare R2 for CSV exports. Leave empty to write exports to LOCAL_DATA_DIR instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

LOCAL_DATA_DIR=.local-data
